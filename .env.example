# GEMINI_API_KEY: Required for Gemini AI API calls on the server.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: HMAC signing secret for server-issued auth cookies/tokens (auto-generated in dev if omitted; required in production).
SESSION_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET"

# Local SQLite database and private document storage paths
DB_PATH="./data/exportbridge.db"
STORAGE_DIR="./storage/uploads"

# Optional external integration credentials (leave empty for local runtime; configure for production Supabase/QwenWork deployments)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
QWENWORK_API_KEY=""
QWENWORK_ENDPOINT=""
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
